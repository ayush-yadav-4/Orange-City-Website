# Public site (safe to expose in browser)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="Orange City Batteries - Nagpur"
NEXT_PUBLIC_BUSINESS_PHONE="+919325417265"
NEXT_PUBLIC_BUSINESS_WHATSAPP="919325417265"
NEXT_PUBLIC_BUSINESS_EMAIL="orders@ocbnagpur.in"
NEXT_PUBLIC_BUSINESS_ADDRESS="Surya Nagar, Pardi, Nagpur, Maharashtra 440008"

# Admin panel — set a strong password in production
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Supabase PostgreSQL (from Supabase → Project Settings → Database)
# Use port 6543 + pgbouncer=true for serverless (Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Use port 5432 for migrations / prisma db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional — Razorpay (leave empty for COD-only)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
